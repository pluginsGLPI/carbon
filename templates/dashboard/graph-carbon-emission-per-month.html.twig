<style>
    #{{ id }} {
        background-color: {{ color }};
        color: {{ fg_color }};
    }

    #{{ id }}:hover {
        background-color: {{ fg_hover_color }};
        border: 1px solid {{ fg_hover_border }};
    }

    .theme-dark #{{ id }} {
      background-color: {{ fg_color }};
      color: {{ color }};
    }

    .theme-dark #{{ id }}:hover {
        background-color: {{ fg_hover_color }};
        color: {{ fg_color }};
        border: 1px solid {{ fg_hover_border }};
    }

    #{{ id }} .card-body {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    #{{ id }}_carbon_emission_chart {
        flex: 1 1 auto;
        height: 100%;
        min-height: 0;
        width: 100%;
    }
  </style>
<div class="card" id="{{ id }}">
  <div class="card-body">
      <div id="{{ id }}_carbon_emission_chart"></div>
  </div>
</div>

{% block scripts %}
<script type="module">
  (async () => {
    if (window.location.href.includes('dashboard')) {
      document.getElementById('cardBodyBorder1').classList.add('border', 'border-2');
    }

    const chartElement = document.getElementById('{{ id }}_carbon_emission_chart');
    const carbonEmissionPerMonthChart = echarts.init(chartElement);
    const chartOptions = {{ data|json_encode(constant('JSON_PRETTY_PRINT'))|raw }};
    chartOptions.yAxis[1].axisLabel = {
      formatter: (value) => Number(Number(value).toPrecision(4)).toString()
    };
    carbonEmissionPerMonthChart.setOption(chartOptions);

    const chartResizeObserver = new ResizeObserver(() => carbonEmissionPerMonthChart.resize());
    chartResizeObserver.observe(chartElement);
  })();
</script>
{% endblock %}
