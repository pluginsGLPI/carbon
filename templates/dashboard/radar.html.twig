<style>
    #{{ chart_id }} {
        background-color: {{ color }};
        color: {{ fg_color }};
    }

    #{{ chart_id }}:hover {
        background-color: {{ fg_hover_color }};
        border: 1px solid {{ fg_hover_border }};
    }

    .theme-dark #{{ chart_id }} {
        background-color: {{ dark_bg_color }};
        color: {{ dark_fg_color }};
    }

    #{{ chart_id }} .chart {
        height: 100%;
        min-height: 200px;
        width: 100%;
    }
</style>

<div class="card g-chart {{ class }}" id="{{ chart_id }}">
    {% if data.radar.indicator|length == 0 %}
        <div class="empty-card no-data">{{ __('No data found') }}</div>
        <i class="main-icon {{ icon }}"></i>
    {% else %}
        <div class="chart"></div>
    {% endif %}
</div>

{% if data.radar.indicator|length > 0 %}
    {% block scripts %}
        <script type="module">
        (async () => {
            const chartElement = document.querySelector('#{{ chart_id }} .chart');
            const chart = echarts.init(chartElement);
            chart.setOption({{ data|json_encode(constant('JSON_PRETTY_PRINT'))|raw }});

            const chartResizeObserver = new ResizeObserver(() => chart.resize());
            chartResizeObserver.observe(chartElement);
        })();
        </script>
    {% endblock %}
{% endif %}